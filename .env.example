# Neon Serverless PostgreSQL Connection String (Pooler or Direct)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js v5 Secret Key (generate with `npx auth secret` or `openssl rand -base64 33`)
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"

# Comma-separated list of Lecturer Google account emails (case-insensitive)
LECTURER_EMAILS="dosen1@univ.ac.id,dosen2@gmail.com,lecturer@academic.ac.id"

# Base URL and Host trust (required for local production build or custom domains)
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
