# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js build output
/.next/
/out/
/build
/dist

# Production and local environment files
.env
.env*.local
.env.production
.env.development
.env.test

# Keep .env.example tracked
!.env.example

# Debug and execution logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel deployment artifacts
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS generated files (macOS & Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor directories
.idea/
.vscode/
*.swp
*.swo
*.swn
*~

# Certificate / Secret files
*.pem
*.key
*.cert
*.crt
